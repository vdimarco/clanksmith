{
  // Existing Worker for clanksmith.com and www.clanksmith.com.
  // Deploying this name updates that Worker, so the custom domains stay attached.
  // index.js sends www and plain HTTP to the apex, sends /mcp to the relay, handles /x/webhook, and serves ../site for every other path.
  // Market writes stay off unless CLANKSMITH_LIVE_WRITES is true and AGENT_MARKET_DRY_RUN is false.
  // AGENT_MARKET_AGENT_TOKEN and AGENT_MARKET_BUYER_KEY are secrets. Set them with `wrangler secret put`. They are not in this file.
  // X replies stay off until X_REPLY_MODE is set with `wrangler secret put`. It is not a plain var here, because a deploy would reset it.
  // Allowed values are off, dry-run, and live. Do not set live in this file.
  // Other X secrets, also via `wrangler secret put`, are not in this file:
  // X_CLIENT_SECRET, X_API_SECRET, X_API_KEY, X_ACCESS_TOKEN, X_ACCESS_TOKEN_SECRET,
  // X_OAUTH2_USER_TOKEN, X_OAUTH2_REFRESH_TOKEN, X_BEARER_TOKEN, X_REVIEW_TOKEN, HERMES_API_KEY,
  // CHAT_WAKE_URL, CHAT_WAKE_AUTH.
  // X_CLIENT_ID is the public OAuth 2.0 client id. The cron wakes the token refresh.
  // REPLY_MODEL is the chat model on the Nous endpoint. It is not a secret. Haiku is the automatic backup.
  "name": "clanksmith",
  "main": "./index.js",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "routes": [
    { "pattern": "clanksmith.com", "custom_domain": true },
    { "pattern": "www.clanksmith.com", "custom_domain": true }
  ],
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "vars": {
    "AGENT_MARKET_BASE": "https://market.near.ai",
    "AGENT_MARKET_DRY_RUN": "true",
    "CLANKSMITH_LIVE_WRITES": "false",
    "X_CLIENT_ID": "c1JNLUNNZ2YwTXhGZlZFTzZ3M2Y6MTpjaQ",
    "REPLY_MODEL": "x-ai/grok-4.3"
  },
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "ClanksmithRelay" },
      { "name": "X_INBOX", "class_name": "XInbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ClanksmithRelay"] },
    { "tag": "v2", "new_sqlite_classes": ["XInbox"] }
  ]
}
